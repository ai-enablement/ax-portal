# -----------------------------------------------------------------------------
# Agent Governance Portal - Azure Web App + Hybrid Connection
# Copy this file to .env and replace every CHANGE_ME value.
# PostgreSQL SSL is intentionally disabled for the requested internal network.
# Never commit the completed .env file.
# -----------------------------------------------------------------------------

# The PGHOST and PGPORT values must match the Azure Hybrid Connection endpoint.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=agent_governance_portal
PGUSER=agent_portal_app
PGPASSWORD=CHANGE_ME
PGSSLMODE=disable

# Connection pool and timeout limits
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=30000
PGCONNECTION_TIMEOUT_MS=5000
PGSTATEMENT_TIMEOUT_MS=15000

# Public Azure Web App origin. Replace it after the Web App is created.
NEXT_PUBLIC_APP_URL=http://localhost:4180

# Microsoft Entra performs authentication only. Portal roles are managed in
# Admin & Governance and stored in agent_portal.users.app_role. These two
# bootstrap lists create the first leader/admin who can manage that catalog.
PORTAL_BOOTSTRAP_LEADER_EMAILS=choi.bd@changshininc.com
# Multiple emails are supported. Separate them with commas, semicolons, or spaces.
PORTAL_BOOTSTRAP_ADMIN_EMAILS=portal.admin@changshininc.com,second.admin@changshininc.com
PORTAL_ORGANIZATION_CODE=CHANGSHIN_INC
PORTAL_ORGANIZATION_NAME=창신INC
PORTAL_AI_TEAM_CODE=AI_ENABLEMENT
PORTAL_AI_TEAM_NAME=AI 활성화팀

# Local development only. Never enable the role switcher in Azure production.
PORTAL_DEV_USER_EMAIL=choi.bd@changshininc.com
PORTAL_DEV_USER_NAME=최병두
PORTAL_DEV_ROLE_SWITCHER=false
