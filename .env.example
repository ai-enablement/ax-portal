# -----------------------------------------------------------------------------
# Agent Governance Portal - on-premises PostgreSQL connection
# Copy this file to .env and replace every CHANGE_ME value.
# PostgreSQL SSL is intentionally disabled for the requested internal network.
# Never commit the completed .env file.
# -----------------------------------------------------------------------------

# PostgreSQL connection used only by the on-premises API gateway
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=agent_governance_portal
PGUSER=agent_portal_app
PGPASSWORD=CHANGE_ME
PGSSLMODE=disable

# Connection pool and timeout limits
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=30000
PGCONNECTION_TIMEOUT_MS=5000
PGSTATEMENT_TIMEOUT_MS=15000

# On-premises API gateway
PORTAL_GATEWAY_HOST=0.0.0.0
PORTAL_GATEWAY_PORT=8787
PORTAL_GATEWAY_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
PORTAL_ALLOWED_ORIGINS=http://127.0.0.1:4180,http://localhost:4180,https://agent-governance-portal-roleflow.ax-gpt.chatgpt.site

# Portal worker -> on-premises gateway proxy
# Local development can use HTTP. Production Sites should use a private HTTP
# tunnel or an approved HTTPS gateway URL.
DATABASE_GATEWAY_URL=http://127.0.0.1:8787
DATABASE_GATEWAY_TOKEN=CHANGE_ME_TO_THE_SAME_VALUE_AS_PORTAL_GATEWAY_TOKEN
