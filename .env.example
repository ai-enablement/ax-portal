# -----------------------------------------------------------------------------
# Agent Governance Portal - Azure Web App + Hybrid Connection
# Copy this file to .env and replace every CHANGE_ME value.
# PostgreSQL SSL is intentionally disabled for the requested internal network.
# Never commit the completed .env file.
# -----------------------------------------------------------------------------

# The PGHOST and PGPORT values must match the Azure Hybrid Connection endpoint.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=agent_governance_portal
PGUSER=agent_portal_app
PGPASSWORD=CHANGE_ME
PGSSLMODE=disable

# Connection pool and timeout limits
PGPOOL_MAX=10
PGIDLE_TIMEOUT_MS=30000
PGCONNECTION_TIMEOUT_MS=5000
PGSTATEMENT_TIMEOUT_MS=15000

# Public Azure Web App origin. Replace it after the Web App is created.
NEXT_PUBLIC_APP_URL=http://localhost:4180
